g important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn9le05ob05re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Make up a ghost story.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn9le05ob05re2img01.jpg"}, {"text": "I've always loved spending time in the country. I've spent many summers in northern Ontario with family, but I've never spent a more interesting one than in 1990. If you let me, I'll tell you what happened. <br/>Great Aunt Ethel lived in a farmhouse up north. She was very old. If you asked her exactly how old, she would only smile. If you talked about her moving to an apartment, she would just shake her head. I adored her and stayed whenever I could. That's why I was there that night.", "id": 1, "time": "100", "image": "engenn9le05ob05re2img01.jpg"}, {"text": "I arrived in the evening. If I think back, I can still remember how pale she looked - almost faded. Her waist-length hair was unpinned and she was unusually quiet. We looked at some old photographs. I told her about my life. If she spoke, it was only a few words. She seemed tired, so we went to bed early. <br/>It was 2 a.m. when Aunt Ethel woke me. She was standing in the bedroom doorway with an old kerosene lamp in her hand. \u201cI'm sorry Dora. I have to go.\u201d she said, then left.", "id": 2, "time": "33000", "image": "engenn9le05ob05re2img02.jpg"}, {"text": "I must have gone back to sleep. When I woke, my cousin Amy was there. \u201cWe forgot you were visiting,\u201d she said softly, \u201cuntil Aunt Ethel said your name.\u201d<br/>\u201cWhat do you mean?\u201d I asked.<br/>\u201cWe took her to the hospital yesterday morning. She passed at two this morning.\u201d<br/>I've thought about that night many times since then. I haven't got an explanation. Have you?", "id": 3, "time": "70000", "image": "engenn9le05ob05re2img03.jpg"}], "audiosrc": "engenn9le05ob05re2aud01", "coverimg": "engenn9le05ob05re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}], "_data": [{"type": "metadata", "contents": [{"content": "Strange Stories", "type": "lesson_name"}, {"content": "The Visitation", "type": "unit_name"}, {"content": 5, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 5, "type": "lesson"}, {"content": "B2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe ways of solving problems and getting things done in social contexts.", "type": "primary"}, {"content": "Understands specific information in written texts about the different social contexts. ", "type": "secondary_1"}, {"content": "Understands specific information in written texts about the different social contexts. ", "type": "secondary_2"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_3"}, {"content": "Understands specific information in written texts about the different social contexts. ", "type": "secondary_4"}, {"content": "Understands specific information in written texts about the different social contexts. ", "type": "secondary_5"}, {"content": "Understands specific information in written texts about the different social contexts. ", "type": "secondary_6"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_7"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_8"}]}, {"content": "engenn9le05ob05re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "The First Conditional vs. The Second Conditional ", "type": "heading"}, {"content": "You use the <span class=\"strong\">first conditional </span> to talk about real situations in the present or future.<br/><br/>You use the <span class=\"strong\">second conditional</span> to talk about unreal or imaginary (hypothetical) situations in the future.", "type": "describer"}, {"content": "First conditional form:<br/>If + Simple Present verb, + will<br/><span class=\"italic\">If you come over, I'll help you with that.</span><br/>(you can come over)", "type": "text"}, {"content": "Second conditional form:<br/>If + Simple Past verb,    + would<br/><span class=\"italic\">If you had time, I would help you with that.</span><br/>(I don't think or I know you don't have time)", "type": "text"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"First Conditional<br/>(Cause and Effect)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Second Conditional<br/>(Hypothetical Situations)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">If I you let me, I'll tell you what happened. <br/><br/>If I think back, I can still remember how pale she looked - almost faded. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">If you asked her exactly how old, she would only smile. <br/><br/>If you talked about her moving to an apartment, she would just shake her head. <br/><br/>If she spoke, it was only a few words. </span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "Remember to use a comma (,) after the IF clause. ", "type": "text"}, {"content": "In conversation, it is common to use contractions. (I would = I'd).", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": "The Present Perfect Tense vs. The Simple Past Tense", "type": "heading"}, {"content": "You use the <span class=\"strong\">Present Perfect </span> for actions which started in the past and are still happening now OR for finished actions which have a connection to the present.<br/><br/>You use the <span class=\"strong\">Simple Past</span> for something that was finished at a certain period of time.", "type": "describer"}, {"content": "{\"rows\":3,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Rule\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Explanation\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The <span class=\\\"strong\\\">Present Perfect</span> is used when the time period has NOT finished.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I haven't got an explanation. <br/><br/>I've thought about that night many times since then. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The time period goes up to the present.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" The <span class=\\\"strong\\\">Simple Past</span> is used when the time period HAS finished.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">When I woke, my cousin Amy was there.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Last night has finished.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "I've always loved spending time in the country. <br/>I've spent many summers in northern Ontario with family, but I've never spent a more interesting one than in 1990. ", "type": "example"}, {"content": "Great Aunt Ethel lived in a farmhouse up north. <br/>She was very old.<br/>I adored her and stayed whenever I could. <br/>That's why I was there that night. ", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to shake your head", "type": "name"}, {"content": "to move your head from side to side meaning \u2018no'", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: If you talked about her moving to an apartment, she would just shake her head.", "type": "example"}, {"content": "engenn9le05ob05aud02", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about a strange event.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "farmhouse", "type": "name"}, {"content": "a farmer's residence", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Great Aunt Ethel lived in a farmhouse up north. ", "type": "example"}, {"content": "engenn9le05ob05aud01", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "pale", "type": "name"}, {"content": "extremely white", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: If I think back, I can still remember how pale she looked.", "type": "example"}, {"content": "engenn9le05ob05aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "unpinned", "type": "name"}, {"content": "allowed to fall loose", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Her waist-length hair was unpinned and she was unusually quiet. ", "type": "example"}, {"content": "engenn9le05ob05aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to pass", "type": "name"}, {"content": "to die", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: She passed at two this morning.", "type": "example"}, {"content": "engenn9le05ob05aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "faded", "type": "name"}, {"content": "faint in color", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: I can still remember how pale she looked - almost faded. ", "type": "example"}, {"content": "engenn9le05ob05aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "doorway", "type": "name"}, {"content": "an opening to enter a building", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: She was standing in the bedroom doorway with an old kerosene lamp in her hand. ", "type": "example"}, {"content": "engenn9le05ob05aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "kerosene", "type": "name"}, {"content": "a liquid fuel often used in old lamps ", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: She was standing in the bedroom doorway with an old kerosene lamp in her hand. ", "type": "example"}, {"content": "engenn9le05ob05aud08", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Reread the text.", "type": "text"}, {"content": "Brainstorm ideas for your own ghost story and write out the points on a timeline.", "type": "text"}, {"content": "Write your story using the Present Perfect and Simple Past tenses.", "type": "text"}, {"content": "Use the first and second conditional if possible.", "type": "text"}, {"content": "Read your finished story aloud to a partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I brainstorm ideas for a ghost story.", "type": "text"}, {"content": "I write the ideas on a timeline.", "type": "text"}, {"content": "I use the Present Perfect and Simple Past tenses to write the ghost story.", "type": "text"}, {"content": "I use the first and second conditional if possible.", "type": "text"}, {"content": "I share my story with a partner.", "type": "text"}]}], "type": "sena"}