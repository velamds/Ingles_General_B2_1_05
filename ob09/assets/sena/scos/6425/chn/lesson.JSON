roup_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "DFL_background_image", "content": ""}, {"type": "exercise_background_image", "content": ""}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Click on the words and move them into the correct category."}]}]}, {"stimuli_ids": [], "type": "RSLT", "questions": [{"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 1}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}]}], "template_override": 1, "id": 10, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}, {"stimuli_ids": [], "type": "DWS", "questions": [{"responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn9le05ob09re7pdf01.pdf "}]}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Write about a themed hotel or restaurant."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "<span class=\"strong\">\nInstructions: </span>Complete the following steps. Fill in the Self Assessment.\n"}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le05ob09re2img01.jpg", "audiosrc": "engenn9le05ob09re2aud01", "images": [{"time": "0", "image": "engenn9le05ob09re2img01.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn9le05ob09re2img01.jpg", "text": "I have never slept in jail, but my boyfriend surprised me with an impromptu visit to Ottawa to do just that. I appreciate having new experiences, but spending time sitting in a jail cell was hardly at the top of my list.<br/><br/>When we arrived at the Carleton County Gaol, the 150-year-old building looked less formidable than I imagined. Surprisingly, I have visited several old jails in the past. This one was rather quaint in comparison.  The stone and brick walls have weathered well. They looked golden-rose in the evening light.", "id": 1}, {"time": "33000", "image": "engenn9le05ob09re2img02.jpg", "text": "The owners have strived to retain a feeling of authenticity in the cells. Even the old barred doors are still in place. You can't help feeling a little closed in though. They haven't turned the cells into luxury suites. Although they have upgraded a little. We sat in a lounge to relax, had complimentary breakfast arrive at our cell door in the morning and of course there was wifi too!", "id": 2}, {"time": "58000", "image": "engenn9le05ob09re2img03.jpg", "text": "In the morning we went on a free tour. A guide took us all around the heritage building. She enjoyed scaring us with tales of ghosts who supposedly walk there. Needless to say, we didn't consider staying again that night!<br/><br/>The hostel has become well-known by the adventurous. I wouldn't hesitate to recommend it. If you've dreamed about roughing it in a cell but haven't got a lot to spend, this is the place to come. I had a great time!", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}, {"contents": [{"type": "img", "value": "engenn9le05ob09re3img01.jpg"}], "template_override": 1, "title": "", "type": "audio", "id": 2, "_data": []}, {"contents": [{"type": "img", "value": "engenn9le05ob09re4img01.jpg"}], "template_override": 1, "title": "", "type": "audio", "id": 3, "_data": []}, {"contents": [{"type": "img", "value": "engenn9le05ob09re5img01.jpg"}], "template_override": 1, "title": "", "type": "audio", "id": 4, "_data": []}, {"contents": [{"type": "img", "value": "engenn9le05ob09re6img01.jpg"}], "template_override": 1, "title": "", "type": "audio", "id": 5, "_data": []}, {"contents": [{"type": "img", "value": "engenn9le05ob09re6img02.jpg"}], "template_override": 1, "title": "", "type": "audio", "id": 6, "_data": []}, {"contents": [{"type": "img", "value": "engenn9le05ob09re6img03.jpg"}], "template_override": 1, "title": "", "type": "audio", "id": 7, "_data": []}, {"contents": [{"type": "img", "value": "engenn9le05ob09re6img04.jpg"}], "template_override": 1, "title": "", "type": "audio", "id": 8, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Strange Stories"}, {"type": "unit_name", "content": "A Night in Jail"}, {"type": "position", "content": 9}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 5}, {"type": "level", "content": "B2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Relate information about problems."}, {"type": "secondary_1", "content": "Understands specific information in written texts about the different social contexts."}, {"type": "secondary_2", "content": "Understands specific information in written texts about the different social contexts."}, {"type": "secondary_3", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_4", "content": "Understands specific information in written texts about the different social contexts."}, {"type": "secondary_5", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_6", "content": "Understands specific information in written texts about the different social contexts."}, {"type": "secondary_7", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. Understands specific information in written texts about the different social contexts."}, {"type": "secondary_8", "content": "Understands specific information in written texts about the different social contexts."}]}, {"type": "background_image", "content": "engenn9le05ob09re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Present Perfect Tense vs. Past Simple "}, {"type": "describer", "content": " "}, {"type": "text", "content": "You use the <span class=\"strong\"> Present Perfect</span>:  </li><li>For something that started in the past and continues in the present. </li></ul> Example: <br> <span class=\"italic\"> I have been married for ten years.</span> <br><br> </li><li>For something that has been done several times. </li></ul>Example: <br> <span class=\"italic\">She has sung that song a lot of times. I love it!!  </span> <br> <br></li><li>For experiences up to the present. </li></ul> Example: <br><span class=\"italic\">This is the worst experience I've ever had.</span> <br><br></li><li> For something that happened in the past but is relevant at the time of speaking. </li></ul>  Example: <br> <span class=\"italic\"> I can't get into the hotel. I've lost my key. </span> <br> <br> </li><li>For referring to a time that is not yet finished. </li></ul> Example: <br> <span class=\"italic\">They have bought a new house this week.</span>"}, {"type": "text", "content": "You use the <span class=\"strong\"> Simple Past </span>for: <br></li><li>  Something that was finished at a certain period of time. </li></ul>  Example: <br>  <span class=\"italic\">The architect finished the building in 1990.</span> "}, {"type": "table", "content": "{\"rows\":5,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Sentence\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" When?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> When we arrived at the Carleton County Gaol, the 150 year old building looked less formidable than I imagined. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" when we arrived\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">They looked golden-rose in the evening light.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" the night we stayed there\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> I have never slept in jail.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" at any time in my life\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">The stone and brick walls have weathered well.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" over the years since they were built\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "Surprisingly, I have visited several old jails in the past. "}, {"type": "example", "content": "They haven't turned the cells into luxury suites."}, {"type": "example", "content": "Although they have upgraded a little."}, {"type": "example", "content": "The hostel has become well-known by the adventurous. "}, {"type": "example", "content": "My boyfriend surprised me with an impromptu visit to Ottawa to do just that."}, {"type": "example", "content": "This one was rather quaint in comparison.  "}, {"type": "example", "content": "We sat in a lounge to relax, had complimentary breakfast arrive at our cell door in the morning and of course there was WiFi too! "}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Gerunds and Infinitives"}, {"type": "describer", "content": "A <span class=\"strong\">gerund</span> is a verb ending with -ing (doing).<br/>An <span class=\"strong\">infinitive</span> is to + verb (to do)."}, {"type": "text", "content": "There are some verbs that can only be followed by a gerund:"}, {"type": "text", "content": "appreciate (doing)<br/>can't help (doing)<br/>enjoy (doing)<br/>spend time (doing)<br/>consider (doing)<br/>dream about (doing)"}, {"type": "text", "content": "Example:  <br/><span class=\"italic\">I <span class=\"strong\">appreciate having</span> new experiences.</span>"}, {"type": "text", "content": "A phrasal verb is always followed by a gerund."}, {"type": "text", "content": "Example:<br/><span class=\"italic\">If you've <span class=\"strong\">dreamed about roughing</span> it in a cell, this is the place to come.</span>"}, {"type": "text", "content": "There are some verbs that can only be followed by an infinitive:"}, {"type": "text", "content": "strive (to do)<br/>hesitate (to do)"}, {"type": "text", "content": "Example:<br/><span class=\"italic\">I wouldn't <span class=\"strong\">hesitate to</span> recommend it. </span>"}, {"type": "example", "content": "<span class=\"strong\">Spending time sitting</span> in a jail cell was hardly at the top of my list."}, {"type": "example", "content": "You <span class=\"strong\">can't help feeling</span> a little closed in though."}, {"type": "example", "content": "She <span class=\"strong\">enjoyed scaring</span> us with tales of ghosts."}, {"type": "example", "content": "We didn't <span class=\"strong\">consider staying</span> again that night!"}, {"type": "example", "content": "The owners have strived <span class=\"strong\">to retain</span> a feeling of authenticity in the cells."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "jail"}, {"type": "definition", "content": "a prison"}, {"type": "part_speech", "content": "(noun) "}, {"type": "example", "content": "Example: I have never slept in jail."}, {"type": "audio", "content": "engenn9le05ob09aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about a night in jail."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "impromptu"}, {"type": "definition", "content": "done without preparation"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: My boyfriend surprised me with an impromptu visit to Ottawa to do just that. "}, {"type": "audio", "content": "engenn9le05ob09aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "at the top of my list"}, {"type": "definition", "content": "first, of the things that I want to do"}, {"type": "part_speech", "content": "(expression) "}, {"type": "example", "content": "Example: Spending time sitting in a jail cell was hardly at the top of my list."}, {"type": "audio", "content": "engenn9le05ob09aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "formidable"}, {"type": "definition", "content": "inspiring fear"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: The 150 year old building looked less formidable than I imagined."}, {"type": "audio", "content": "engenn9le05ob09aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to weather"}, {"type": "definition", "content": "to change from being exposed to the weather"}, {"type": "part_speech", "content": "(verb) "}, {"type": "example", "content": "Example: The stone and brick walls have weathered well."}, {"type": "audio", "content": "engenn9le05ob09aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "quaint"}, {"type": "definition", "content": "old-fashioned charm"}, {"type": "part_speech", "content": "(adjective) "}, {"type": "example", "content": "Example:This one was rather quaint in comparison."}, {"type": "audio", "content": "engenn9le05ob09aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to strive"}, {"type": "definition", "content": "to try hard"}, {"type": "part_speech", "content": "(verb) "}, {"type": "example", "content": "Example: They strived to keep their customers."}, {"type": "audio", "content": "engenn9le05ob09aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "authenticity"}, {"type": "definition", "content": "genuine; as it was originally"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The owners have strived to retain a feeling of authenticity in the cells."}, {"type": "audio", "content": "engenn9le05ob09aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "barred"}, {"type": "definition", "content": "enclosed with bars"}, {"type": "part_speech", "content": "(adjective) "}, {"type": "example", "content": "Example: Even the old barred doors are still in place. "}, {"type": "audio", "content": "engenn9le05ob09aud09"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Look up the Lock Up - a prison themed restaurant in Japan or another themed restaurant or hotel and read or watch a video about it."}, {"type": "text", "content": "Make notes about the themed restaurant or hotel."}, {"type": "text", "content": "Write up a description of the place."}, {"type": "text", "content": "Include as many verb plus infinitive and verb plus gerund as you can."}, {"type": "text", "content": "Read your description aloud to a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I look up a themed restaurant or hotel and make notes."}, {"type": "text", "content": "I write a description of the themed restaurant or hotel."}, {"type": "text", "content": "I use verb plus infinitive and verb plus gerund where I can."}, {"type": "text", "content": "I share my description with a partner."}]}]}