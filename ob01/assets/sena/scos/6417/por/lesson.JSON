xt", "content": "starting it got"}]}, {"type": "post_question", "contents": {"type": "", "content": "sick. <br/>"}}, {"type": "objective", "content": "secondary_8"}]}, {"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": "tried"}]}], "id": 2, "_data": [{"type": "question", "contents": [{"type": "text", "content": "I"}]}, {"type": "incorrect", "contents": [{"type": "text", "content": "try"}]}, {"type": "post_question", "contents": {"type": "", "content": "to give it some medicine,"}}, {"type": "objective", "content": "secondary_8"}]}, {"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": "appeared to get"}]}], "id": 3, "_data": [{"type": "question", "contents": [{"type": "text", "content": "but it"}]}, {"type": "incorrect", "contents": [{"type": "text", "content": "appearing do got"}]}, {"type": "post_question", "contents": {"type": "", "content": "better without it. "}}, {"type": "objective", "content": "secondary_8"}]}], "template_override": 2, "id": 10, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " What do rabbits eat?"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions:<span class=\"bullet\">Proofread the sentence.</span>\n<span class=\"bullet\">Click on the incorrect word.</span>\n<span class=\"bullet\">Type in the correct word to complete the sentence. </span> <span class=\"bullet\">Use capital letters where necessary.</span>"}]}, {"type": "template_override", "content": 2}]}, {"stimuli_ids": [], "type": "RSLT", "questions": [{"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le05ob01re2img01.jpg", "audiosrc": "engenn9le05ob01re2aud01", "images": [{"time": "0", "image": "engenn9le05ob01re2img01.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn9le05ob01re2img01.jpg", "text": "Okunoshima  island, I was shocked to find out, has had a dark past. You can arrange to visit this small Japanese island that's only a short trip from the mainland. A place, that for many years, did not, in fact exist.<br/><br/>Between 1929-1945 the island was home to the Japanese army and was used to house a secret poison gas factory. Because of this, the island was removed from Japanese maps. It just appeared to disappear!", "id": 1}, {"time": "28000", "image": "engenn9le05ob01re2img02.jpg", "text": "The army chose to use Okunoshima because of its discreet location and distance from civilian populations. They decided to bring rabbits to the island in order to test the effects of the poison on them.<br/><br/>Today the island has changed.  The poison gas factory has closed down and has been replaced by a museum. The military lookout posts around the island have fallen into ruin. However, the descendants of the the unfortunate test rabbits are still there, and they have grown in number.", "id": 2}, {"time": "58000", "image": "engenn9le05ob01re2img03.jpg", "text": "The island now has a hotel, a six-hole golf course and a small camping ground. Visitors are able to swim in the clean water surrounding the island. But all that most day-visitors think about doing is feeding the feral rabbits. After all, they are the real attraction.<br/><br/>Imagine walking roaming wooded areas and walking the paths, being chased by hundreds of wild bunnies! You can't help thinking how cute they are, even when they are swarming all over you trying to get to that food you brought along!", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Strange Stories"}, {"type": "unit_name", "content": "Island of Rabbits"}, {"type": "position", "content": 1}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 5}, {"type": "level", "content": "B2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Relate information about common solutions to problems."}, {"type": "secondary_1", "content": "Understands specific information in written texts about the different social contexts."}, {"type": "secondary_2", "content": "Understands specific information in written texts about the different social contexts."}, {"type": "secondary_3", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_4", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_5", "content": "Understands specific information in written texts about the different social contexts."}, {"type": "secondary_6", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_7", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_8", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}]}, {"type": "background_image", "content": "engenn9le05ob01re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Present Perfect Tense vs. Simple Past Tense"}, {"type": "describer", "content": "You use the <span class=\"strong\"> Present Perfect</span>: "}, {"type": "text", "content": "</li><li>For something that started in the past and continues in the present. </li></ul> Example: <br> <span class=\"italic\"> I have studied English since 2014.</span> <br><br> </li><li>For something that has been done several times. </li></ul>Example: <br> <span class=\"italic\">I have read this book four times. </span> <br> <br></li><li>For experiences up to the present. </li></ul> Example: <br><span class=\"italic\"> This is the best trip I've ever had.</span> <br><br></li><li> For something that happened in the past but is relevant at the time of speaking. </li></ul>  Example: <br> <span class=\"italic\"> I can't call her. I've lost my cellphone. </span> <br> <br> </li><li>For referring to a time that is not yet finished. </li></ul> Example: <br> <span class=\"italic\">Have you seen Richard today?</span>"}, {"type": "text", "content": "You use the <span class=\"strong\"> Simple Past </span>for: <br></li><li>  Something that was finished at a certain period of time. </li></ul>  Example: <br>  <span class=\"italic\">I saw Richard yesterday. </span> <br> <span class=\"italic\">I finished my project two hours ago. </span>"}, {"type": "text", "content": " "}, {"type": "table", "content": "{\"rows\":5,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Sentence\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"When\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> Between 1929-1945 the island was home to the Japanese army. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" between 1929-1945\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">It just appeared to disappear! </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" at the time previously mentioned\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> The poison gas factory has closed down and has been replaced by a museum. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" sometime after the war ended but when is not stated\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> The unfortunate test rabbits are still there and they have grown in number.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" since they were set free sometime in the past \\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "It was used to house a secret poison gas factory. "}, {"type": "example", "content": "Because of this, the island was removed from Japanese maps. "}, {"type": "example", "content": "Today the island has changed.  "}, {"type": "example", "content": "The military lookout posts around the island have fallen into ruin. "}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Gerunds and Infinitives"}, {"type": "describer", "content": "A <span class=\"strong\">gerund</span> is a verb ending with -ing (doing).<br/>An <span class=\"strong\">infinitive</span> is to + verb (to do)."}, {"type": "text", "content": "There are some verbs that can only be followed by a gerund: "}, {"type": "text", "content": "think about (doing)<br/>imagine (doing)<br/>can't help (doing)"}, {"type": "text", "content": "Example:  <span class=\"italic\"><br/><span class=\"strong\">Imagine walking</span> roaming wooded areas and walking the paths, <span class=\"strong\">being</span> chased by hundreds of wild bunnies! </span>"}, {"type": "text", "content": "You always use a gerund after a phrasal verb.<br/>Example:<br/><span class=\"italic\">But all that most day-visitors <span class=\"strong\">think about</span> doing is feeding the feral rabbits.</span>"}, {"type": "text", "content": "There are some verbs that can only be followed by an infinitive:"}, {"type": "text", "content": "shocked (to do)<br/>used (to do)<br/>arrange (to do)<br/>appear (to do)<br/>choose (to do)<br/>decide (to do)<br/>be able (to do)"}, {"type": "text", "content": "Example:<br/><span class=\"italic\">It was <span class=\"strong\">used to</span> house a secret poison gas factory.</span>"}, {"type": "text", "content": "There are some verbs that can be followed by either an infinitive or a gerund with a difference in meaning:"}, {"type": "text", "content": "try (to do)  attempt unsuccessfully<br/>try (doing) experiment by doing different things "}, {"type": "text", "content": "Examples:<br/><span class=\"italic\"><span class=\"strong\">They are trying</span> to get to that food you brought along!</span><br/>(they haven't been successful)"}, {"type": "text", "content": "<span class=\"italic\">You should <span class=\"strong\">try leaving</span> the bag of food and <span class=\"strong\">moving</span> away from it to lose them.</span><br/>(experiment that way first)"}, {"type": "example", "content": "Okunoshima island, I was <span class=\"strong\">shocked to</span> find out, has had a dark past."}, {"type": "example", "content": "You can <span class=\"strong\">arrange to</span> visit this small Japanese island that's only a short trip from the mainland."}, {"type": "example", "content": "The army <span class=\"strong\">chose to</span> use Okunoshima because of its discreet location and distance from civilian populations. "}, {"type": "example", "content": "They <span class=\"strong\">decided to</span> bring rabbits to the island in order to test the effects of the poison on them."}, {"type": "example", "content": "Visitors are <span class=\"strong\">able to</span> swim in the clean water surrounding the island. "}, {"type": "example", "content": "It just <span class=\"strong\">appeared to</span> disappear! "}, {"type": "example", "content": "You <span class=\"strong\">can't help thinking</span> how cute they are, even when they are swarming all over."}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about a strange island."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to shock"}, {"type": "definition", "content": "cause (someone) to feel surprised and upset"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I was shocked to find out, he has had a dark past."}, {"type": "audio", "content": "engenn9le05ob01aud01"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "feral"}, {"type": "definition", "content": "not domesticated "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Most visitors think about feeding the feral rabbits."}, {"type": "audio", "content": "engenn9le05ob01aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "poison"}, {"type": "definition", "content": "a substance that is capable of causing the illness or death "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The island was used to house a secret poison gas factory."}, {"type": "audio", "content": "engenn9le05ob01aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "gas"}, {"type": "definition", "content": "an airlike fluid substance with the ability to expand without limit"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The island was used to house a secret poison gas factory."}, {"type": "audio", "content": "engenn9le05ob01aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to remove"}, {"type": "definition", "content": "to eliminate"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: The island was removed from Japanese maps. "}, {"type": "audio", "content": "engenn9le05ob01aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "discreet"}, {"type": "definition", "content": "careful or tactful in one's conduct or speech"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: The army chose to use Okunoshima because of its discreet location. "}, {"type": "audio", "content": "engenn9le05ob01aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to appear"}, {"type": "definition", "content": "to become visible or noticeable"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: The Island appeared through the fog."}, {"type": "audio", "content": "engenn9le05ob01aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "civilian"}, {"type": "definition", "content": "a person who is not with the military"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The poison gas plant is far from civilian populations."}, {"type": "audio", "content": "engenn9le05ob01aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "military"}, {"type": "definition", "content": "the armed forces"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The military lookout posts around the island have fallen into ruin."}, {"type": "audio", "content": "engenn9le05ob01aud09"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "lookout post"}, {"type": "definition", "content": "a place for a guard or a soldier to keep watch"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The souldier  left his lookout posts after his shift."}, {"type": "audio", "content": "engenn9le05ob01aud10"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Go online or to the library to find out about an interesting island."}, {"type": "text", "content": "Find out where it is, what happens there, who goes there and what there is to do. "}, {"type": "text", "content": "Explain why it is interesting."}, {"type": "text", "content": "Write 200 words giving the full information in your own words."}, {"type": "text", "content": "Try to use verb + gerund and verb + infinitive in your writing."}, {"type": "text", "content": "Read your writing to a partner."}, {"type": "text", "content": "Discuss your island with them and get their opinion of it as well."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I find out about and interesting island."}, {"type": "text", "content": "I write the full information about it in 200 words."}, {"type": "text", "content": "I use verb + gerund and verb + infinitive in my writing about the island."}, {"type": "text", "content": "I share my written piece with a partner."}, {"type": "text", "content": "I ask my partner for his or her opinion of the island."}]}]}