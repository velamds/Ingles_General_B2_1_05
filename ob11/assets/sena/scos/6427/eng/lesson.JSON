erride": 1}, {"id": 9, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "Paul has been", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "taechin", "type": "text"}]}, {"type": "post_question", "contents": {"content": " learning strategies for almost ten years.", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "teaching", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}, {"_data": [{"type": "question", "contents": [{"content": "Yesterday Paul", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "adviced", "type": "text"}]}, {"type": "post_question", "contents": {"content": "his students to take an interest in what they were studying.", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "advised", "type": "text"}], "selected": 0, "correct": 1}], "id": 1}, {"_data": [{"type": "question", "contents": [{"content": "He also", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "encorage", "type": "text"}]}, {"type": "post_question", "contents": {"content": "them to get enough sleep when he spoke to them.", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "encouraged", "type": "text"}], "selected": 0, "correct": 1}], "id": 2}, {"_data": [{"type": "question", "contents": [{"content": "A study has shown that getting enough sleep", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "helpings", "type": "text"}]}, {"type": "post_question", "contents": {"content": "us retain important information.", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "helps", "type": "text"}], "selected": 0, "correct": 1}], "id": 3}], "_data": [{"type": "instructions", "contents": [{"content": " Paul gives some tips on how to learn faster ...", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions:\n<span class=\"bullet\">Proofread the sentence.</span>\n<span class=\"bullet\">Click on the incorrect word.</span>\n<span class=\"bullet\">Type in the correct word to complete the sentence.<span class=\"bullet\"> Use capital letters where necessary.</span> ", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}]}], "type": "GIW", "template_override": 1}, {"id": 10, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": []}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn9le05ob11re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Talk about your English learning experience so far.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn9le05ob11re2img01.jpg"}, {"text": "Would you like to go to bed while a soothing voice whispered a lesson into your sleeping ears?<br/><br/>It has come to light that people all over the world have been trying out the new \"learn while you sleep\" method to study all sorts of subjects. English appears to be one of them. Specialists have run a number of experiments.", "id": 1, "time": "0001", "image": "engenn9le05ob11re2img01.jpg"}, {"text": "The fact the participants in the study have been learning three times more than they can during the day can't be ignored. Learning in their sleep has helped them to achieve far more than expected!<br/><br/>Language learners using this method have been able to do it in an amazing speed. These students haven't been spending time staring into space in the evening when they should be studying, they have been out enjoying themselves! Unfortunately, sleep learning tends to help you only remember things that you've already learned while awake.", "id": 2, "time": "19000", "image": "engenn9le05ob11re2img02.jpg"}, {"text": "In the study, specialists experimented by teaching people English over the radio. Students did ten lessons every two weeks. Before they went to sleep, they completed one lesson in English grammar and vocabulary. Then, peaceful music put them to sleep. A quiet voice whispered the lesson over again while they were slumbering.<br/><br/>Learning while you sleep may sound illogical, but, it seems to work. So if learning English is at the top of your list, there may come a day when you may find yourself learning it while in deep repose.", "id": 3, "time": "53000", "image": "engenn9le05ob11re2img03.jpg"}], "audiosrc": "engenn9le05ob11re2aud01", "coverimg": "engenn9le05ob11re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}], "_data": [{"type": "metadata", "contents": [{"content": "Strange Stories", "type": "lesson_name"}, {"content": "Learning English is Like a Dream", "type": "unit_name"}, {"content": 11, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 5, "type": "lesson"}, {"content": "B2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe ways of solving problems and getting things done in social contexts.", "type": "primary"}, {"content": "Understands specific information in written texts about the different social contexts", "type": "secondary_1"}, {"content": "Understands specific information in written texts about the different social contexts", "type": "secondary_2"}, {"content": "Understands specific information in written texts about the different social contexts", "type": "secondary_3"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_4"}, {"content": "Understands specific information in written texts about the different social contexts", "type": "secondary_5"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_6"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_7"}, {"content": "Understands specific information in written texts about the different social contexts", "type": "secondary_8"}]}, {"content": "engenn9le05ob11re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Present Perfect vs. The Simple Past Tense", "type": "heading"}, {"content": "You use the <span class=\"strong\">Present Perfect </span>  for actions which started in the past and are still happening now OR for finished actions which have a connection to the present.<br/><br/>You use the <span class=\"strong\">Simple Past</span> for past events or actions which have no connection to the present.", "type": "describer"}, {"content": "{\"rows\":3,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Rule\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Explanation\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The <span class=\\\"strong\\\">Simple Past</span> is used when the time period HAS finished.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">In the study, specialists experimented by teaching people English over the radio.<br/><br/>Students did ten lessons every two weeks. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" when the study was done\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The <span class=\\\"strong\\\">Present Perfect</span> is used when the time period has NOT finished.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Learning in their sleep has helped them to achieve far more than expected!</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" since they started studying this way\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "A quiet voice whispered the lesson over again while they were slumbering.", "type": "example"}, {"content": "Unfortunately, sleep learning tends to help you only remember things that you've already learned while awake.", "type": "example"}, {"content": "Before they went to sleep, they completed one lesson in English grammar and vocabulary. Then, peaceful music put them to sleep.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Present Perfect Continuous vs. Present Perfect", "type": "heading"}, {"content": " ", "type": "describer"}, {"content": "You use the <span class=\"strong\">Present Perfect tense </span> to talk about a past action or an action that began in the past that is connected to the present in some way. <br/><br/>You can use the  <span class=\"strong\">Present Perfect tense</span> to talk about experiences.<br/>When you use the Present Perfect tense, you think about the past and present together. There is some connection between what happened in the past and now. To emphasize the  <span class=\"strong\">result</span> of the action, use the simple form.<ul><li><span class=\"italic\">What happened to her?</span></li></ul>", "type": "text"}, {"content": "You use  <span class=\"strong\">Present Perfect Continuous tense</span> to describe:<li> a single activity that lasts a long time </li><li> an action that is repeated over a long period of time </li></ul>These continue up to the present. You can use the  <span class=\"strong\">Present Perfect Continuous tense</span> when a long activity has just stopped. <br> To emphasize the  <span class=\"strong\">action</span>, use the continuous form.<ul><li><span class=\"italic\">What have the other people in the cafe been doing?</span></ul></li>", "type": "text"}, {"content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Sentence\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> Specialists have run a number of experiments. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" at an unspecified time in the past they ran them\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">The fact the participants in the study have been learning three times more than they can during the day can't be ignored. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" they have happened for a while now\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": " Language learners using this method have been able to do it at an amazing speed. ", "type": "example"}, {"content": "These students haven't been spending time staring into space in the evening when they should be studying, they have been out enjoying themselves! ", "type": "example"}, {"content": "It has come to light that people all over the world have been trying out the new \"learn while you sleep\" method to study all sorts of subjects. ", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to appear", "type": "name"}, {"content": "to give the impression", "type": "definition"}, {"content": "(verb) ", "type": "part_speech"}, {"content": "Example:  English appears to be one of them.", "type": "example"}, {"content": "engenn9le05ob11aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you need to review.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "illogical", "type": "name"}, {"content": "irrational", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: Learning while you sleep may sound illogical but it seems to work.", "type": "example"}, {"content": "engenn9le05ob11aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to stare into space", "type": "name"}, {"content": "focusing on nothing", "type": "definition"}, {"content": "(verb) ", "type": "part_speech"}, {"content": "Example: These students haven't been spending time staring into space in the evening when they should be studying.", "type": "example"}, {"content": "engenn9le05ob11aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to ignore", "type": "name"}, {"content": "to pay no attention to", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The fact the participants in the study have been learning three times more than they can during the day can't be ignored.", "type": "example"}, {"content": "engenn9le05ob11aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to come to light", "type": "name"}, {"content": "to become known or to be discovered", "type": "definition"}, {"content": "(expression) ", "type": "part_speech"}, {"content": "Example: It has come to light that people all over the world have been trying out the new \"learn while you sleep\". ", "type": "example"}, {"content": "engenn9le05ob11aud05", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Talk with a partner and discuss when you started learning English and what you learned then.", "type": "text"}, {"content": "Then discuss what you have learned since then.", "type": "text"}, {"content": "Finally, talk about what you have been learning this year.", "type": "text"}, {"content": "Discuss what you have found easier and more difficult when learning.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I discuss learning English with a partner.", "type": "text"}, {"content": "I use the Past Simple tense to describe past learning.", "type": "text"}, {"content": "I use the Present Perfect tense to describe what I've learned since then.", "type": "text"}, {"content": "I use the Present Perfect Continuous tense to describe what I have been learning recently.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "at the top of my list", "type": "name"}, {"content": "first of the things that I want to do", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: So if learning English is at the top of your list, there may come a day when you may find yourself learning it while in deep repose.", "type": "example"}, {"content": "engenn9le05ob11aud06", "type": "audio"}]}], "type": "sena"}