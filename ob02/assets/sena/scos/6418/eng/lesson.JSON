ontent": "became", "type": "text"}], "correct": 1, "id": 3, "selected": 0}, {"_data": [{"content": "intoxicated", "type": "text"}], "correct": 1, "id": 4, "selected": 0}, {"_data": [{"content": "after", "type": "text"}], "correct": 1, "id": 5, "selected": 0}, {"_data": [{"content": "being", "type": "text"}], "correct": 1, "id": 6, "selected": 0}, {"_data": [{"content": "fed", "type": "text"}], "correct": 1, "id": 7, "selected": 0}, {"_data": [{"content": "whiskey", "type": "text"}], "correct": 1, "id": 8, "selected": 0}, {"_data": [{"content": ".", "type": "text"}], "correct": 1, "id": 9, "selected": 0}], "id": 2}]}, {"stimuli_ids": [], "id": 11, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!"}, "type": "feedback"}], "type": "RSLT", "template_override": 1, "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"_data": [{"content": "", "type": "text"}], "correct": 0, "id": 0, "selected": 0}, {"_data": [{"content": "", "type": "text"}], "correct": 1, "id": 1, "selected": 0}], "id": 0}]}], "type": "scholar", "stimuli": [{"_data": [], "type": "welcome", "template_override": 1, "id": 0, "contents": [{}]}, {"title": "", "id": 1, "contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le05ob02re2img01.jpg", "audiosrc": "engenn9le05ob02re2aud01", "images": [{"time": "0", "image": "engenn9le05ob02re2img01.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn9le05ob02re2img01.jpg", "id": 1, "text": "It was  March in South Africa and the marula were ripe. In fact much of it, growing wild, was fermenting in the sun. Thousands of the oval yellow fruit were lying on the forest floor when the elephants discovered them. They spent a long time devouring the sweet pulp and tangy skin. <br/><br/>Suddenly,  they were weaving, stumbling and falling all over each other. A field guide who was driving through the area stopped. What was wrong? What had those elephants been up to?"}, {"time": "35500", "image": "engenn9le05ob02re2img02.jpg", "id": 2, "text": "He  took pictures of the calves and adults that were lying in a contented pile. When the wind changed, he caught a whiff of the fermented fruit. It was then that he realized that the elephants were tipsy. He had to laugh!<br/><br/>Unfortunately, sometimes drunk elephants get angry. In the village of Dumurkota in India, a small herd of elephants wandered in at night and drank more than 100 gallons of homemade mahua alcohol. When they were done they started pushing their way into homes."}, {"time": "71000", "image": "engenn9le05ob02re2img03.jpg", "id": 3, "text": "They were looking for more of the good stuff. Many of the villagers were sleeping when they heard the intoxicated animals crashing through their walls. Then, someone was shouting a general alarm and people were up and running. <br/><br/>They were still waiting for the elephants to move away from their flattened dwellings a few hours later when the sun came up. As a precaution, the citizens of Dumurkota now distill and store their mahua alcohol some distance from their homes!"}]}}], "_data": [], "type": "audio", "template_override": 1}], "id": 0}]}